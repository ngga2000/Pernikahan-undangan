<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Portfolio | DesignKita</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box
}

html{
scroll-behavior:smooth
}

body{
font-family:Arial,Helvetica,sans-serif;
background:#08080b;
color:#fff;
line-height:1.6;
overflow-x:hidden
}

a{
text-decoration:none;
color:inherit
}

/* BACKGROUND */

body:before,
body:after{
content:"";
position:fixed;
width:350px;
height:350px;
border-radius:50%;
filter:blur(100px);
opacity:.18;
z-index:-1
}

body:before{
background:#ff2f92;
top:-150px;
left:-100px
}

body:after{
background:#713cff;
right:-100px;
bottom:-150px
}

/* NAVBAR */

nav{
position:fixed;
top:0;
left:0;
right:0;
height:70px;
padding:0 7%;
display:flex;
align-items:center;
justify-content:space-between;
background:rgba(8,8,11,.75);
backdrop-filter:blur(15px);
border-bottom:1px solid #ffffff10;
z-index:999
}

.logo{
font-size:22px;
font-weight:800
}

.logo span{
color:#ff4fa3
}

.nav{
display:flex;
gap:30px;
list-style:none
}

.nav a{
font-size:14px;
color:#aaa;
transition:.3s
}

.nav a:hover{
color:#fff
}

.menu{
display:none;
font-size:25px;
cursor:pointer
}

/* HERO */

.hero{
min-height:100vh;
padding:130px 7% 70px;
display:flex;
align-items:center
}

.hero-wrap{
max-width:1200px;
width:100%;
margin:auto;
display:grid;
grid-template-columns:1.2fr .8fr;
gap:70px;
align-items:center
}

.status{
display:inline-flex;
align-items:center;
gap:8px;
padding:8px 14px;
border:1px solid #ffffff15;
background:#ffffff08;
border-radius:50px;
color:#aaa;
font-size:12px;
margin-bottom:25px
}

.status i{
width:7px;
height:7px;
border-radius:50%;
background:#3dff9b;
box-shadow:0 0 12px #3dff9b
}

h1{
font-size:clamp(48px,7vw,82px);
line-height:1;
letter-spacing:-5px;
margin-bottom:25px
}

.gradient{
background:linear-gradient(90deg,#ff4fa3,#a56bff,#5d8dff);
-webkit-background-clip:text;
color:transparent
}

.hero p{
max-width:600px;
color:#999;
font-size:16px;
margin-bottom:30px
}

.buttons{
display:flex;
gap:12px;
flex-wrap:wrap
}

.btn{
display:inline-block;
padding:13px 20px;
border-radius:10px;
font-size:14px;
font-weight:bold;
transition:.3s
}

.primary{
background:linear-gradient(135deg,#ff3e98,#804cff)
}

.primary:hover{
transform:translateY(-3px);
box-shadow:0 10px 30px #ff3e9835
}

.secondary{
border:1px solid #ffffff15;
background:#ffffff06
}

.secondary:hover{
background:#ffffff12
}

/* PROFILE CARD */

.profile{
height:420px;
border-radius:30px;
border:1px solid #ffffff12;
background:linear-gradient(145deg,#ffffff0d,#ffffff02);
display:flex;
align-items:center;
justify-content:center;
position:relative;
overflow:hidden
}

.profile:before{
content:"";
position:absolute;
width:220px;
height:220px;
border-radius:50%;
background:linear-gradient(135deg,#ff3e98,#714cff);
filter:blur(30px);
opacity:.6
}

.initial{
position:relative;
width:190px;
height:190px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
font-size:60px;
font-weight:800;
background:#0c0c10;
border:2px solid #ffffff25;
z-index:2
}

.badge{
position:absolute;
padding:10px 14px;
border-radius:10px;
font-size:11px;
background:#111117dd;
border:1px solid #ffffff12;
backdrop-filter:blur(10px);
z-index:3
}

.b1{
top:45px;
left:25px
}

.b2{
bottom:60px;
right:20px
}

.b3{
bottom:25px;
left:35px
}

/* GENERAL */

section{
padding:100px 7%
}

.container{
max-width:1200px;
margin:auto
}

.heading{
margin-bottom:45px
}

.heading small{
color:#ff4fa3;
font-weight:bold;
text-transform:uppercase;
letter-spacing:2px
}

.heading h2{
font-size:clamp(35px,5vw,55px);
line-height:1.1;
letter-spacing:-2px;
margin-top:8px
}

.heading p{
max-width:600px;
color:#777;
margin-top:12px
}

/* ABOUT */

.about{
display:grid;
grid-template-columns:1fr 1fr;
gap:60px
}

.about p{
color:#999;
margin-bottom:18px
}

.stats{
display:grid;
grid-template-columns:1fr 1fr;
gap:15px
}

.stat{
padding:25px;
border-radius:18px;
background:#ffffff05;
border:1px solid #ffffff0d
}

.stat h3{
font-size:35px;
background:linear-gradient(90deg,#ff4fa3,#8c5cff);
-webkit-background-clip:text;
color:transparent
}

.stat span{
font-size:13px;
color:#777
}

/* PROJECT */

.projects{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px
}

.card{
padding:20px;
background:#ffffff04;
border:1px solid #ffffff0d;
border-radius:22px;
transition:.35s
}

.card:hover{
transform:translateY(-7px);
border-color:#ff4fa350
}

.visual{
height:190px;
border-radius:15px;
display:flex;
align-items:center;
justify-content:center;
font-size:55px;
margin-bottom:20px;
background:linear-gradient(135deg,#26101d,#171126)
}

.card:nth-child(2) .visual{
background:linear-gradient(135deg,#101b2d,#21122d)
}

.card:nth-child(3) .visual{
background:linear-gradient(135deg,#282011,#171717)
}

.card h3{
font-size:18px;
margin-bottom:7px
}

.card p{
font-size:13px;
color:#777
}

.tag{
display:inline-block;
margin-top:14px;
padding:5px 9px;
border-radius:7px;
font-size:10px;
background:#ffffff08;
color:#999
}

/* SKILLS */

.skills{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:15px
}

.skill{
padding:25px;
border-radius:18px;
background:#ffffff04;
border:1px solid #ffffff0d
}

.skill-icon{
font-size:28px;
margin-bottom:12px
}

.skill h3{
font-size:15px;
margin-bottom:5px
}

.skill p{
font-size:12px;
color:#777
}

/* SERVICES */

.services{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px
}

.service{
padding:30px;
border-radius:20px;
background:linear-gradient(145deg,#141419,#0c0c0f);
border:1px solid #ffffff0d
}

.number{
color:#ff4fa3;
font-size:11px;
font-weight:bold;
margin-bottom:20px
}

.service h3{
font-size:21px;
margin-bottom:10px
}

.service p{
font-size:13px;
color:#777
}

/* CONTACT */

.contact{
max-width:900px;
margin:auto;
text-align:center;
padding:70px 30px;
border-radius:30px;
background:linear-gradient(135deg,#ff4fa30d,#805cff0d);
border:1px solid #ffffff12
}

.contact h2{
font-size:clamp(38px,6vw,60px);
line-height:1.05;
letter-spacing:-3px;
margin-bottom:18px
}

.contact p{
color:#777;
margin-bottom:25px
}

/* FOOTER */

footer{
padding:35px 7%;
border-top:1px solid #ffffff0a;
display:flex;
justify-content:space-between;
color:#666;
font-size:12px
}

.social{
display:flex;
gap:18px
}

.social a:hover{
color:#ff4fa3
}

/* ANIMATION */

.reveal{
opacity:0;
transform:translateY(25px);
animation:show 1s forwards
}

.d1{animation-delay:.15s}
.d2{animation-delay:.3s}
.d3{animation-delay:.45s}

@keyframes show{
to{
opacity:1;
transform:translateY(0)
}
}

/* MOBILE */

@media(max-width:900px){

.nav{
display:none;
position:absolute;
top:70px;
right:5%;
width:210px;
padding:20px;
background:#111116;
border:1px solid #ffffff12;
border-radius:15px;
flex-direction:column;
gap:18px
}

.nav.show{
display:flex
}

.menu{
display:block
}

.hero-wrap{
grid-template-columns:1fr
}

.profile{
height:330px
}

.about{
grid-template-columns:1fr
}

.projects{
grid-template-columns:1fr 1fr
}

.skills{
grid-template-columns:1fr 1fr
}

.services{
grid-template-columns:1fr
}
}

@media(max-width:600px){

nav{
padding:0 5%
}

.hero{
padding:120px 5% 60px
}

section{
padding:75px 5%
}

h1{
letter-spacing:-3px
}

.profile{
height:290px
}

.initial{
width:150px;
height:150px;
font-size:45px
}

.projects{
grid-template-columns:1fr
}

.skills{
grid-template-columns:1fr
}

footer{
flex-direction:column;
gap:15px;
text-align:center
}

.stats{
gap:10px
}

.stat{
padding:18px
}
}
</style>
</head>

<body>

