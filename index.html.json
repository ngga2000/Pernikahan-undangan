<script>

function menu(){

document
.getElementById("nav")
.classList
.toggle("show");

}

document.querySelectorAll(".nav a").forEach(function(link){

link.addEventListener("click",function(){

document
.getElementById("nav")
.classList
.remove("show");

});

});

</script>

